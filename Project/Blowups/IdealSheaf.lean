import Project.Blowups.BlowupExists
import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial

/-!
# Blowups along families of ideal sheaves

We express the main theorem `GlobalBlowup_UnivProp` in terms of Mathlib's
`AlgebraicGeometry.Scheme.IdealSheafData` and closed immersions.

## Main definitions

* `AlgebraicGeometry.Scheme.affineOpensCover`: the affine cover of `X` by all of its affine opens.
* `AlgebraicGeometry.Scheme.IdealSheafData.specQuotientIsoPullback`: for an ideal sheaf `I` and
  an affine open `U`, `Spec(Γ(X, U)/I(U))` is the pullback of `I.subschemeι` along `U ⟶ X`.
* `AlgebraicGeometry.Scheme.IdealSheafData.toPreClos`: the `PreClos` attached to a family of
  ideal sheaves, with ideals `I i U` on the cover by all affine opens.
* `AlgebraicGeometry.Scheme.IdealSheafData.toClos`: its class in `Clos X`.
* `AlgebraicGeometry.Scheme.IdealSheafData.IsEffectiveCartier`: an ideal sheaf is effective
  Cartier if it is locally generated by a single non-zero-divisor.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.exists_blowup`: for a finite family of ideal sheaves
  on `X` there is a scheme `B` over `X` on which the family becomes Cartier, and which is
  terminal among such schemes over `X`.
* `AlgebraicGeometry.Scheme.IdealSheafData.exists_blowup_of_isClosedImmersion`: the same
  statement for a finite family of closed immersions, through their kernels.
* `AlgebraicGeometry.Scheme.IdealSheafData.isCars_pullback_toClos_iff`: for a finite family,
  `IsCars` of the pullback along `g` is equivalent to every `(I i).comap g` being effective
  Cartier.
* `AlgebraicGeometry.Scheme.IdealSheafData.exists_blowup_isEffectiveCartier`: the universal
  property of the blowup, stated entirely with Mathlib notions.
* `AlgebraicGeometry.Scheme.IdealSheafData.exists_blowup_isEffectiveCartier_of_isClosedImmersion`:
  the same for a finite family of closed immersions.
-/

suppress_compilation

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme

/-- The affine cover of `X` by all of its affine opens. -/
def affineOpensCover (X : Scheme.{u}) : Scheme.AffineCover.{u} @IsOpenImmersion X where
  J := X.affineOpens
  obj U := Γ(X, U)
  map U := U.2.fromSpec
  f x := (X.openCoverOfISupEqTop _ (iSup_affineOpens_eq_top X)).f x
  covers x := by
    let U := (X.openCoverOfISupEqTop _ (iSup_affineOpens_eq_top X)).f x
    obtain ⟨⟨y, hy : y ∈ U.1⟩, rfl : y = x⟩ :=
      (X.openCoverOfISupEqTop _ (iSup_affineOpens_eq_top X)).covers x
    rw [IsAffineOpen.range_fromSpec]
    exact hy

namespace IdealSheafData

variable {X : Scheme.{u}} (I : X.IdealSheafData) (U : X.affineOpens)

lemma range_subschemeCover_map :
    Set.range (I.subschemeCover.map U).base =
      Set.range (pullback.fst I.subschemeι U.2.fromSpec).base := by
  have h := congrArg (fun V : TopologicalSpace.Opens I.subscheme ↦ (V : Set I.subscheme))
    (I.opensRange_subschemeCover_map U)
  simp only [Hom.coe_opensRange] at h
  rw [h, IsOpenImmersion.range_pullback_fst_of_right]
  change _ = I.subschemeι.base ⁻¹' Set.range U.2.fromSpec.base
  rw [IsAffineOpen.range_fromSpec]
  rfl

/-- `Spec(Γ(X, U)/I(U))` is the pullback of the subscheme of `I` along `Spec Γ(X, U) ⟶ X`. -/
def specQuotientIsoPullback :
    Spec (.of (Γ(X, U) ⧸ I.ideal U)) ≅ pullback I.subschemeι U.2.fromSpec :=
  IsOpenImmersion.isoOfRangeEq (I.subschemeCover.map U) (pullback.fst _ _)
    (I.range_subschemeCover_map U)

@[reassoc (attr := simp)]
lemma specQuotientIsoPullback_hom_fst :
    (I.specQuotientIsoPullback U).hom ≫ pullback.fst _ _ = I.subschemeCover.map U :=
  IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _

@[reassoc (attr := simp)]
lemma specQuotientIsoPullback_hom_snd :
    (I.specQuotientIsoPullback U).hom ≫ pullback.snd _ _ =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.ideal U))) := by
  rw [← cancel_mono U.2.fromSpec, Category.assoc, ← pullback.condition,
    specQuotientIsoPullback_hom_fst_assoc, subschemeCover_map_subschemeι, glueDataObjι_ι]

end IdealSheafData

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u+1}} {ι : Type} (I : ι → X.IdealSheafData)

/-- The `PreClos` attached to a family of ideal sheaves: the subschemes are the
`(I i).subscheme`, the cover is the cover by all affine opens, and the ideal of `I i`
on the affine open `U` is `(I i).ideal U`. -/
def toPreClos : PreClos X where
  indnumb := ι
  subscheme i := (I i).subscheme
  over i := ⟨(I i).subschemeι⟩
  cov := X.affineOpensCover
  ideal i U := (I i).ideal U
  condiso i U := (I i).specQuotientIsoPullback U
  condover i U := ⟨(I i).specQuotientIsoPullback_hom_snd U⟩

/-- The class in `Clos X` of a family of ideal sheaves. -/
def toClos : Clos X := Quotient.mk'' (toPreClos I)

/-- **Blowups along ideal sheaves.** For a finite family of ideal sheaves on `X`, there is a
scheme `B` over `X` on which the family becomes Cartier, such that every scheme `T` over `X`
on which the family becomes Cartier has a unique morphism to `B` over `X`. -/
theorem exists_blowup [Finite ι] :
    ∃ (B : Scheme.{u+1}) (_ : B.Over X), IsCars _ (pullback_Clos (B ↘ X) (toClos I)) ∧
      ∀ (T : Scheme.{u+1}) [T.Over X], IsCars _ (pullback_Clos (T ↘ X) (toClos I)) →
        ∃! φ : T ⟶ B, φ.IsOver X := by
  classical
  set Z : Clos X := toClos I
  have hR : Nonempty (relStructure Z.out (toPreClos I)) := Quotient.exact (Quotient.out_eq Z)
  let e : Z.out.indnumb ≃ ι := hR.some.indnumb_equiv
  haveI : Finite Z.out.indnumb := Finite.of_equiv ι e.symm
  refine ⟨GlobalBlowup Z, inferInstance, ?_, fun T _ hT ↦ GlobalBlowup_UnivProp Z hT⟩
  exact GlobalBlowup_IsCars Z

/-- **Blowups along closed subschemes.** The same statement for a finite family of closed
immersions `Z i ⟶ X`, through their kernels (see `AlgebraicGeometry.overEquivIdealSheafData`). -/
theorem exists_blowup_of_isClosedImmersion [Finite ι] {Z : ι → Scheme.{u+1}}
    (f : ∀ i, Z i ⟶ X) [∀ i, IsClosedImmersion (f i)] :
    ∃ (B : Scheme.{u+1}) (_ : B.Over X),
      IsCars _ (pullback_Clos (B ↘ X) (toClos fun i ↦ (f i).ker)) ∧
      ∀ (T : Scheme.{u+1}) [T.Over X],
        IsCars _ (pullback_Clos (T ↘ X) (toClos fun i ↦ (f i).ker)) →
        ∃! φ : T ⟶ B, φ.IsOver X :=
  exists_blowup fun i ↦ (f i).ker

end AlgebraicGeometry.Scheme.IdealSheafData

/-! ### Effective Cartier ideal sheaves -/

namespace AlgebraicGeometry

variable {T : Scheme.{u+1}}

lemma _root_.PreClos.isClosedImmersion (W : PreClos T) (j : W.indnumb) :
    IsClosedImmersion (W.subscheme j ↘ T) := by
  rw [IsLocalAtTarget.iff_of_openCover (P := @IsClosedImmersion) W.cov.cover]
  intro γ
  have h : (W.condiso j γ).hom ≫ pullback.snd _ _ =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (W.ideal j γ))) :=
    (W.condover j γ).comp_over
  rw [← MorphismProperty.cancel_left_of_respectsIso @IsClosedImmersion (W.condiso j γ).hom]
  change IsClosedImmersion ((W.condiso j γ).hom ≫ pullback.snd _ _)
  rw [h]
  infer_instance

/-- On the image of a chart, the kernel of `W.subscheme j ⟶ T` is the chart ideal,
transported along `Γ(T, image) ≅ Γ(Spec R, ⊤) ≅ R`. -/
lemma _root_.PreClos.ker_ideal_chart (W : PreClos T) (j : W.indnumb) (γ : W.cov.J) :
    haveI := W.cov.map_prop γ
    (W.subscheme j ↘ T).ker.ideal
        ⟨W.cov.map γ ''ᵁ ⊤, (isAffineOpen_top _).image_of_isOpenImmersion _⟩ =
      (W.ideal j γ).comap ((W.cov.map γ).appIso ⊤ ≪≫ Scheme.ΓSpecIso _).hom.hom := by
  haveI := W.cov.map_prop γ
  haveI := W.isClosedImmersion j
  have h : (W.condiso j γ).hom ≫ pullback.snd _ _ =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (W.ideal j γ))) :=
    (W.condover j γ).comp_over
  have H := Scheme.ker_ideal_of_isPullback_of_isOpenImmersion
    (W.subscheme j ↘ T) (pullback.snd (W.subscheme j ↘ T) (W.cov.map γ)) (pullback.fst _ _)
    (W.cov.map γ) (IsPullback.of_hasPullback _ _).flip ⟨⊤, isAffineOpen_top _⟩
  have hsnd : pullback.snd (W.subscheme j ↘ T) (W.cov.map γ) = (W.condiso j γ).inv ≫
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (W.ideal j γ))) := by
    rw [← h, Iso.inv_hom_id_assoc]
  rw [hsnd, Scheme.Hom.ker_comp_of_isIso, Scheme.Hom.ker_apply] at H
  apply_fun Ideal.comap ((W.cov.map γ).appIso ⊤).hom.hom at H
  rw [Ideal.comap_comap, ← CommRingCat.hom_comp, Iso.hom_inv_id, CommRingCat.hom_id,
    Ideal.comap_id] at H
  rw [← H]
  ext a
  simp only [Ideal.mem_comap, RingHom.mem_ker, Iso.trans_hom, CommRingCat.hom_comp,
    RingHom.coe_comp, Function.comp_apply]
  have nat := Scheme.ΓSpecIso_naturality
    (CommRingCat.ofHom (Ideal.Quotient.mk (W.ideal j γ)))
  have := congrArg (fun φ => φ.hom (((W.cov.map γ).appIso ⊤).hom a)) nat
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at this
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  change _ ↔ (CommRingCat.ofHom (Ideal.Quotient.mk (W.ideal j γ))).hom _ = 0
  rw [← this]
  exact (map_eq_zero_iff _ (ConcreteCategory.bijective_of_isIso
    (Scheme.ΓSpecIso (CommRingCat.of (↑(W.cov.obj γ) ⧸ W.ideal j γ))).hom).1).symm

namespace Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- `I` is generated on the affine open `U` by a single non-zero-divisor. -/
def IsPrincipalNZDOn (I : X.IdealSheafData) (U : X.affineOpens) : Prop :=
  ∃ f ∈ nonZeroDivisors Γ(X, U), I.ideal U = Ideal.span {f}

/-- An ideal sheaf is *effective Cartier* if it is locally generated by a single
non-zero-divisor. -/
def IsEffectiveCartier (I : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ U : X.affineOpens, x ∈ U.1 ∧ I.IsPrincipalNZDOn U

lemma isPrincipalNZDOn_of_eq_comap (I : X.IdealSheafData) (U : X.affineOpens) {R : Type*}
    [CommRing R] (e : Γ(X, U) ≃+* R) {J : Ideal R} (hI : I.ideal U = J.comap e)
    {g : R} (hg : g ∈ nonZeroDivisors R) (hJ : J = Ideal.span {g}) :
    I.IsPrincipalNZDOn U := by
  refine ⟨e.symm g, RingEquiv.mem_nonZeroDivisors_map e.symm hg, ?_⟩
  rw [hI, hJ, ← e.symm_symm, Ideal.comap_symm, Ideal.map_span, Set.image_singleton,
    e.symm_symm]

lemma IsPrincipalNZDOn.congr {I : X.IdealSheafData} {U V : X.affineOpens}
    (h : I.IsPrincipalNZDOn U) (e : U.1 = V.1) : I.IsPrincipalNZDOn V := by
  obtain rfl : U = V := Subtype.ext e
  exact h

lemma IsPrincipalNZDOn.basicOpen {I : X.IdealSheafData} {U : X.affineOpens}
    (h : I.IsPrincipalNZDOn U) (f : Γ(X, U)) : I.IsPrincipalNZDOn (X.affineBasicOpen f) := by
  obtain ⟨a, ha, hI⟩ := h
  let ρ := X.presheaf.map (homOfLE <| X.basicOpen_le f).op
  letI := ρ.hom.toAlgebra
  haveI : IsLocalization.Away f Γ(X, X.basicOpen f) := U.2.isLocalization_basicOpen f
  refine ⟨ρ.hom a, IsLocalization.nonZeroDivisors_le_comap (Submonoid.powers f)
    Γ(X, X.basicOpen f) ha, ?_⟩
  rw [← I.map_ideal_basicOpen U f, hI, Ideal.map_span, Set.image_singleton]

end Scheme.IdealSheafData

namespace Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- A finite family of effective Cartier ideal sheaves is simultaneously generated by
non-zero-divisors on a common affine neighbourhood of every point. -/
lemma exists_isPrincipalNZDOn {ι : Type*} [Finite ι] (I : ι → X.IdealSheafData)
    (h : ∀ i, (I i).IsEffectiveCartier) (x : X) :
    ∃ U : X.affineOpens, x ∈ U.1 ∧ ∀ i, (I i).IsPrincipalNZDOn U := by
  classical
  haveI := Fintype.ofFinite ι
  suffices H : ∀ s : Finset ι, ∃ U : X.affineOpens, x ∈ U.1 ∧ ∀ i ∈ s, (I i).IsPrincipalNZDOn U by
    obtain ⟨U, hxU, hU⟩ := H Finset.univ
    exact ⟨U, hxU, fun i ↦ hU i (Finset.mem_univ i)⟩
  intro s
  induction s using Finset.induction_on with
  | empty =>
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
      (isBasis_affine_open X).exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
    exact ⟨⟨U, hU⟩, hxU, by simp⟩
  | insert i s _ ih =>
    obtain ⟨V, hxV, hV⟩ := ih
    obtain ⟨U, hxU, hU⟩ := h i x
    obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter U.2 V.2 x ⟨hxU, hxV⟩
    refine ⟨X.affineBasicOpen g, show x ∈ X.basicOpen g from hfg ▸ hxf, fun j hj ↦ ?_⟩
    rcases Finset.mem_insert.mp hj with rfl | hj
    · exact (hU.basicOpen f).congr hfg
    · exact (hV j hj).basicOpen g

/-- The affine cover of `X` by the affine opens in `S`, assuming they cover `X`. -/
def affineOpensCoverOf (S : Set X.affineOpens) (hS : ∀ x : X, ∃ U ∈ S, x ∈ U.1) :
    Scheme.AffineCover.{u} @IsOpenImmersion X where
  J := S
  obj U := Γ(X, U.1)
  map U := U.1.2.fromSpec
  f x := ⟨(hS x).choose, (hS x).choose_spec.1⟩
  covers x := by
    rw [IsAffineOpen.range_fromSpec]
    exact (hS x).choose_spec.2

end Scheme.IdealSheafData

namespace Scheme.IdealSheafData

variable {X : Scheme.{u+1}} {ι : Type} (I : ι → X.IdealSheafData)

/-- The `PreClos` of a family of ideal sheaves, on the cover by the affine opens in `S`. -/
def toPreClosOn (S : Set X.affineOpens) (hS : ∀ x : X, ∃ U ∈ S, x ∈ U.1) : PreClos X where
  indnumb := ι
  subscheme i := (I i).subscheme
  over i := ⟨(I i).subschemeι⟩
  cov := affineOpensCoverOf S hS
  ideal i U := (I i).ideal U.1
  condiso i U := (I i).specQuotientIsoPullback U.1
  condover i U := ⟨(I i).specQuotientIsoPullback_hom_snd U.1⟩

variable {T : Scheme.{u+1}} (g : T ⟶ X)

lemma isCars_pullback_toClos_of_isEffectiveCartier [Finite ι]
    (h : ∀ i, ((I i).comap g).IsEffectiveCartier) :
    IsCars _ (pullback_Clos g (toClos I)) := by
  let S : Set T.affineOpens := {U | ∀ i, ((I i).comap g).IsPrincipalNZDOn U}
  have hS : ∀ x : T, ∃ U ∈ S, x ∈ U.1 := fun x ↦
    let ⟨U, hxU, hU⟩ := exists_isPrincipalNZDOn _ h x
    ⟨U, hU, hxU⟩
  let W := toPreClosOn (fun i ↦ (I i).comap g) S hS
  have hW : IsPreCars _ W :=
    isPreCars_of_generators W (fun i U ↦ (U.2 i).choose)
      (fun i U ↦ (U.2 i).choose_spec.2) (fun i U ↦ (U.2 i).choose_spec.1)
  refine ⟨⟨W, hW, Quotient.sound ⟨?_⟩⟩⟩
  exact
    { indnumb_equiv := Equiv.refl ι
      subscheme_iso i := (I i).comapIso g ≪≫ pullbackSymmetry g (I i).subschemeι
      subscheme_iso_over i := by
        rw [Scheme.Hom.isOver_iff]
        change ((I i).comapIso g ≪≫ pullbackSymmetry _ _).hom ≫ pullback.snd _ _ = _
        simp only [Iso.trans_hom, Category.assoc, pullbackSymmetry_hom_comp_snd,
          comapIso_hom_fst]
        rfl }

lemma isEffectiveCartier_of_isCars_pullback_toClos
    (h : IsCars _ (pullback_Clos g (toClos I))) (i : ι) :
    ((I i).comap g).IsEffectiveCartier := by
  obtain ⟨W, hW, hWeq⟩ := h.exists_rep
  have hR : Nonempty (relStructure W (pullback_PreClos X T g (toPreClos I))) :=
    Quotient.exact hWeq
  let R := hR.some
  let e := R.indnumb_equiv
  have hker : ∀ k : W.indnumb, (W.subscheme k ↘ T).ker = (I (e k)).comap g := by
    intro k
    have hov := (R.subscheme_iso_over k).comp_over
    rw [← hov, Scheme.Hom.ker_comp_of_isIso, comap,
      ← pullbackSymmetry_hom_comp_snd g (I (e k)).subschemeι, Scheme.Hom.ker_comp_of_isIso]
    rfl
  have hi := hker (e.symm i)
  rw [Equiv.apply_symm_apply] at hi
  intro x
  let γ := W.cov.f x
  haveI := W.cov.map_prop γ
  refine ⟨⟨W.cov.map γ ''ᵁ ⊤, (isAffineOpen_top _).image_of_isOpenImmersion _⟩, ?_, ?_⟩
  · show x ∈ W.cov.map γ ''ᵁ ⊤
    rw [Scheme.Hom.image_top_eq_opensRange]
    exact W.cov.covers x
  · haveI := hW.prin (e.symm i) γ
    refine isPrincipalNZDOn_of_eq_comap _ _
      ((W.cov.map γ).appIso ⊤ ≪≫ Scheme.ΓSpecIso _).commRingCatIsoToRingEquiv
      (J := W.ideal (e.symm i) γ) ?_ (hW.nonzerodiv (e.symm i) γ)
      (Ideal.span_singleton_generator _).symm
    rw [← hi, W.ker_ideal_chart]
    rfl

/-- The family becomes Cartier along `g` in the sense of `IsCars` if and only if every
pulled-back ideal sheaf is effective Cartier. -/
theorem isCars_pullback_toClos_iff [Finite ι] :
    IsCars _ (pullback_Clos g (toClos I)) ↔ ∀ i, ((I i).comap g).IsEffectiveCartier :=
  ⟨isEffectiveCartier_of_isCars_pullback_toClos I g,
    isCars_pullback_toClos_of_isEffectiveCartier I g⟩

/-- **Blowups along ideal sheaves, in Mathlib's language.** For a finite family of ideal
sheaves on `X`, there is a scheme `B` over `X` on which every pulled-back ideal sheaf is
effective Cartier, and every scheme `T` over `X` with the same property has a unique
morphism to `B` over `X`. -/
theorem exists_blowup_isEffectiveCartier [Finite ι] :
    ∃ (B : Scheme.{u+1}) (_ : B.Over X), (∀ i, ((I i).comap (B ↘ X)).IsEffectiveCartier) ∧
      ∀ (T : Scheme.{u+1}) [T.Over X], (∀ i, ((I i).comap (T ↘ X)).IsEffectiveCartier) →
        ∃! φ : T ⟶ B, φ.IsOver X := by
  obtain ⟨B, _, hB, hU⟩ := exists_blowup I
  refine ⟨B, inferInstance, (isCars_pullback_toClos_iff I _).mp hB, fun T _ hT ↦ ?_⟩
  exact hU T ((isCars_pullback_toClos_iff I _).mpr hT)

/-- **Blowups along closed subschemes, in Mathlib's language.** The same statement for a
finite family of closed immersions `Z i ⟶ X`, through their kernels. -/
theorem exists_blowup_isEffectiveCartier_of_isClosedImmersion [Finite ι]
    {Z : ι → Scheme.{u+1}} (f : ∀ i, Z i ⟶ X) [∀ i, IsClosedImmersion (f i)] :
    ∃ (B : Scheme.{u+1}) (_ : B.Over X),
      (∀ i, ((f i).ker.comap (B ↘ X)).IsEffectiveCartier) ∧
      ∀ (T : Scheme.{u+1}) [T.Over X], (∀ i, ((f i).ker.comap (T ↘ X)).IsEffectiveCartier) →
        ∃! φ : T ⟶ B, φ.IsOver X :=
  exists_blowup_isEffectiveCartier fun i ↦ (f i).ker

end Scheme.IdealSheafData

end AlgebraicGeometry

namespace AlgebraicGeometry

/-- A presented centre is equivalent to the presented centre of the kernels of its
closed immersions. -/
theorem _root_.PreClos.mk_eq_toClos_ker {X : Scheme.{u+1}} (W : PreClos X) :
    (Quotient.mk'' W : Clos X) =
      Scheme.IdealSheafData.toClos fun i ↦ (W.subscheme i ↘ X).ker := by
  refine Quotient.sound ⟨?_⟩
  exact
    { indnumb_equiv := Equiv.refl _
      subscheme_iso i := haveI := W.isClosedImmersion i; asIso (W.subscheme i ↘ X).toImage
      subscheme_iso_over i := by
        rw [Scheme.Hom.isOver_iff]
        exact (W.subscheme i ↘ X).toImage_imageι }

end AlgebraicGeometry
